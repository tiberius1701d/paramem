# ParaMem systemd service — parametric memory server
#
# Before installing, update the paths below to match your environment:
#   - WorkingDirectory, ExecStart
#
# Install (user-scope service — no root required):
#   mkdir -p ~/.config/systemd/user
#   cp scripts/server/paramem-server.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now paramem-server
#
# Logs:
#   journalctl --user -u paramem-server -f

[Unit]
Description=ParaMem Server — parametric memory for personal LLM agents
After=default.target

[Service]
Type=simple
# --- UPDATE THESE FOR YOUR ENVIRONMENT ---
WorkingDirectory=/path/to/paramem
ExecStart=/path/to/python -m paramem.server.app --config configs/server.yaml
# --- END USER CONFIG ---
# Host-specific environment (GPU allocator tuning, feature flags, secrets)
# comes from an editable install's own .env, loaded by the server at
# startup, or from an operator drop-in under paramem-server.service.d/
# with a [Service] Environment= line for a non-editable install.
Restart=on-failure
RestartSec=30
TimeoutStartSec=120
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=paramem

[Install]
WantedBy=default.target
